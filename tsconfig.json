{
  "compilerOptions": {
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./lib",
    "rootDir": "./src",
    "pretty": true,
    "strict": true,
    "target": "ES2017",
    "skipLibCheck": true
  },
  "include": ["./src/**/*"]
}
